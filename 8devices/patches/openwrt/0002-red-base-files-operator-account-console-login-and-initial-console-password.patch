diff --git a/package/base-files/files/usr/libexec/initial-password.sh b/package/base-files/files/usr/libexec/initial-password.sh
new file mode 100755
index 0000000000..b1eca6de8f
--- /dev/null
+++ b/package/base-files/files/usr/libexec/initial-password.sh
@@ -0,0 +1,58 @@
+#!/bin/sh
+# 8devices CRA/RED: run as root by /usr/libexec/login.sh before the console
+# login prompt. Every account that may log in on the console (uid != 0 with a
+# login shell; root is kept off the serial console by /etc/securetty) must
+# have a password. While one of them has none, the console shows a password
+# dialog instead of the login prompt, so the empty-password state cannot be
+# used to log in. The minimum length follows the rpcd password policy
+# (/etc/config/rpcd, policy.pw_length, default 8), the same policy LuCI
+# enforces for root. Nothing happens once every account has a password.
+[ -t 0 ] || exit 0
+
+min_len=$(uci -q get rpcd.policy.pw_length)
+case $min_len in ''|*[!0-9]*) min_len=8 ;; esac
+
+accounts_without_password() {
+	local name pw uid shell
+	while IFS=: read -r name pw uid _ _ _ shell; do
+		[ "$uid" != 0 ] || continue
+		case $shell in */ash|*/sh|*/bash) ;; *) continue ;; esac
+		[ -z "$(awk -F: -v u="$name" '$1 == u { print $2 }' /etc/shadow)" ] && echo "$name"
+	done < /etc/passwd
+}
+
+ask() {
+	local prompt=$1 reply
+	printf '%s' "$prompt" >&2
+	stty -echo 2>/dev/null
+	IFS= read -r reply
+	stty echo 2>/dev/null
+	echo >&2
+	printf '%s' "$reply"
+}
+
+trap '' INT QUIT TSTP
+
+for user in $(accounts_without_password); do
+	echo
+	echo "The account '$user' has no password. A password of at least $min_len characters is required before the console can be used."
+	while :; do
+		pw1=$(ask "New password for $user: ")
+		if [ ${#pw1} -lt "$min_len" ]; then
+			echo "Too short: at least $min_len characters."
+			continue
+		fi
+		pw2=$(ask "Retype password: ")
+		if [ "$pw1" != "$pw2" ]; then
+			echo "Passwords do not match."
+			continue
+		fi
+		if printf '%s\n%s\n' "$pw1" "$pw1" | /bin/busybox passwd "$user" >/dev/null 2>&1 &&
+		   [ -n "$(awk -F: -v u="$user" '$1 == u { print $2 }' /etc/shadow)" ]; then
+			echo "Password set for $user."
+			break
+		fi
+		echo "Setting the password failed, try again."
+	done
+done
+exit 0
diff --git a/package/base-files/files/usr/libexec/login.sh b/package/base-files/files/usr/libexec/login.sh
index e2f898e850..edf86e51d7 100755
--- a/package/base-files/files/usr/libexec/login.sh
+++ b/package/base-files/files/usr/libexec/login.sh
@@ -12,6 +12,7 @@
 	esac
 }
 
-[ "$(uci -q get system.@system[0].ttylogin)" = 1 ] || exec /bin/login -f root
+# 8devices CRA/RED: no console login while a console account has no password
+/bin/sh /usr/libexec/initial-password.sh
 
 exec /bin/login
