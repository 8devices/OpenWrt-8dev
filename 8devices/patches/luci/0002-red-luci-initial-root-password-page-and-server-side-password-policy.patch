From: Robertas Tumas <robertas.t@8devices.com>
Subject: [PATCH] luci: initial root password page and server-side password policy

rpcd on 8devices images refuses to log in to an account without a
password (8devices openwrt series), so a fresh device cannot be logged
into with an empty password at all, neither through the LuCI form nor
through the ubus HTTP endpoint. While root has no password the
dispatcher therefore shows a "set the administrator password" page
(template sysauth_setpw) instead of the login form: two fields, set as
root by the dispatcher through luci setPassword without issuing a
session, then the normal login proceeds with the new password. This
replaces the RED approach of letting the empty password log in and
redirecting the session to the password page, which only covered
template and view requests while every LuCI page talks to /ubus with
the session id, and whose acknowledging UCI flag could be set over that
channel. There is no flag; the state is the shadow entry itself.

The rpcd "luci" plugin's setPassword re-checks the password policy
(/etc/config/rpcd, section "policy": enabled, pw_length, digits, uc_lc,
special_characters) before changing the password and refuses with
result=false and a "Policy: ..." message mirroring the form texts.
Without this the policy was evaluated only in the browser and any ubus
client could set a shorter password. Policy disabled or absent:
unchanged behaviour. Passwords set with busybox passwd on a root shell
are not covered.

The password view's strength check is raised from 6 to 8 characters and
a too-short password blocks the form, as in red/openwrt-luci.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Robertas Tumas <robertas.t@8devices.com>
---
 modules/luci-base/root/usr/share/rpcd/ucode/luci   | 31 ++++++++++++
 modules/luci-base/ucode/dispatcher.uc              | 56 ++++++++++++++++++++++
 modules/luci-base/ucode/template/sysauth_setpw.ut  | 43 +++++++++++++++++
 .../luci-static/resources/view/system/password.js  |  7 +--
 4 files changed, 134 insertions(+), 3 deletions(-)

diff --git a/modules/luci-base/root/usr/share/rpcd/ucode/luci b/modules/luci-base/root/usr/share/rpcd/ucode/luci
index 73ed50d..ad6ce00 100644
--- a/modules/luci-base/root/usr/share/rpcd/ucode/luci
+++ b/modules/luci-base/root/usr/share/rpcd/ucode/luci
@@ -109,6 +109,30 @@ function check_user(source, entry) {
 	return found;
 }
 
+/* 8devices CRA: server-side counterpart of the LuCI password policy
+ * (/etc/config/rpcd, section "policy"). Without this the policy is only
+ * checked in the browser and any ubus client can set a shorter password. */
+function check_password_policy(uci, pwd) {
+	if (uci.get('rpcd', 'policy', 'enabled') != '1')
+		return null;
+
+	const min_length = int(uci.get('rpcd', 'policy', 'pw_length') ?? 0);
+
+	if (min_length > 0 && length(pwd ?? '') < min_length)
+		return `Policy: min. length of ${min_length} characters`;
+
+	if (uci.get('rpcd', 'policy', 'digits') == '1' && !match(pwd, /[0-9]/))
+		return 'Policy: contain digits';
+
+	if (uci.get('rpcd', 'policy', 'uc_lc') == '1' && !(match(pwd, /[a-z]/) && match(pwd, /[A-Z]/)))
+		return 'Policy: contain uppercase/lowercase';
+
+	if (uci.get('rpcd', 'policy', 'special_characters') == '1' && !match(pwd, /[^a-zA-Z0-9]/))
+		return 'Policy: contain special characters';
+
+	return null;
+}
+
 const methods = {
 	getVersion: {
 		call: function(request) {
@@ -523,6 +547,13 @@ const methods = {
 			const known_user = check_user(type, user);
 			const uci = cursor();
 
+			/* 8devices CRA: the password policy is enforced here, not only
+			 * in the LuCI form, so that ubus clients are bound by it too. */
+			const violation = check_password_policy(uci, pwd);
+
+			if (violation)
+				return { result: false, msg: violation };
+
 			if (type == 'unix') {
 				const u = shellquote(user);
 				const p = shellquote(pwd);
diff --git a/modules/luci-base/ucode/dispatcher.uc b/modules/luci-base/ucode/dispatcher.uc
index b6f412a..effcf97 100644
--- a/modules/luci-base/ucode/dispatcher.uc
+++ b/modules/luci-base/ucode/dispatcher.uc
@@ -495,6 +495,20 @@ function randomid(num_bytes) {
 	return hexenc(data);
 }
 
+/* 8devices CRA: true while the root account has no password (empty shadow
+ * field). rpcd refuses to log in to such an account, so the dispatcher
+ * offers the initial password page instead of the login form. */
+function initial_password_required() {
+	for (let line in split(readfile('/etc/shadow') ?? '', '\n')) {
+		let f = split(line, ':');
+
+		if (f[0] == 'root')
+			return (f[1] ?? '') == '';
+	}
+
+	return false;
+}
+
 function session_setup(user, pass, path) {
 	let timeout = uci.get('luci', 'sauth', 'sessiontime');
 	let login = ubus.call("session", "login", {
@@ -959,6 +973,48 @@ dispatch = function(_http, path) {
 					auth_assets = auth_check.assets;
 				}
 
+				/* 8devices CRA: while root has no password nobody can log in,
+				 * so show the initial password page and set the password here,
+				 * as root and without a session; then continue with the login. */
+				if (initial_password_required()) {
+					let setpw_error = null;
+					let pw1 = http.formvalue('luci_newpassword');
+					let pw2 = http.formvalue('luci_confirmpassword');
+
+					if (pw1 != null || pw2 != null) {
+						if (pw1 != pw2) {
+							setpw_error = translate('The passwords do not match.') ?? 'The passwords do not match.';
+						}
+						else {
+							let res = ubus.call('luci', 'setPassword', { username: 'root', password: pw1 });
+
+							if (res?.result) {
+								openlog('dispatcher.uc');
+								syslog(LOG_INFO|LOG_AUTHPRIV, "luci: initial root password set from %s",
+									http.getenv("REMOTE_ADDR") || "?");
+								closelog();
+								user = 'root';
+								pass = pw1;
+							}
+							else {
+								setpw_error = res?.msg ?? translate('Failed to set the password.') ?? 'Failed to set the password.';
+							}
+						}
+					}
+
+					if (initial_password_required()) {
+						resolved.ctx.path = [];
+
+						http.status(403, 'Forbidden');
+						http.header('X-LuCI-Login-Required', 'yes');
+
+						return runtime.render('sysauth_setpw', {
+							error: setpw_error,
+							min_length: +(uci.get('rpcd', 'policy', 'pw_length') ?? 8)
+						});
+					}
+				}
+
 				if (user != null && pass != null)
 					session = session_setup(user, pass, resolved.ctx.request_path);
 
diff --git a/modules/luci-base/ucode/template/sysauth_setpw.ut b/modules/luci-base/ucode/template/sysauth_setpw.ut
new file mode 100644
index 0000000..60da9fb
--- /dev/null
+++ b/modules/luci-base/ucode/template/sysauth_setpw.ut
@@ -0,0 +1,43 @@
+{#
+ 8devices CRA: initial password page. The dispatcher renders it instead of
+ the login form while the root account has no password; rpcd refuses to log
+ in to such an account, so this is the only thing a fresh device offers.
+-#}
+
+{% include('header') %}
+
+<form method="post" autocomplete="off">
+	{% if (error): %}
+		<div class="alert-message warning">
+			<p>{{ entityencode(error) }}</p>
+		</div>
+	{% endif %}
+
+	<div class="cbi-map">
+		<h2 name="content">{{ _('Set the administrator password') }}</h2>
+		<div class="cbi-map-descr">
+			{{ _('This device has no administrator password yet. Choose one before logging in for the first time.') }}
+			{{ sprintf(_('Minimum length: %d characters.'), min_length) }}
+		</div>
+		<div class="cbi-section"><div class="cbi-section-node">
+			<div class="cbi-value">
+				<label class="cbi-value-title">{{ _('New password') }}</label>
+				<div class="cbi-value-field">
+					<input class="cbi-input-text" type="password" name="luci_newpassword" minlength="{{ min_length }}" required autofocus />
+				</div>
+			</div>
+			<div class="cbi-value cbi-value-last">
+				<label class="cbi-value-title">{{ _('Confirm password') }}</label>
+				<div class="cbi-value-field">
+					<input class="cbi-input-text" type="password" name="luci_confirmpassword" minlength="{{ min_length }}" required />
+				</div>
+			</div>
+		</div></div>
+	</div>
+
+	<div class="cbi-page-actions">
+		<input type="submit" value="{{ _('Set password and log in') }}" class="btn cbi-button cbi-button-apply" />
+	</div>
+</form>
+
+{% include('footer') %}
diff --git a/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js b/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
index dd62e78..3f69c74 100644
--- a/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
+++ b/modules/luci-mod-system/htdocs/luci-static/resources/view/system/password.js
@@ -31,7 +31,7 @@ return view.extend({
 		var strength = document.querySelector('.cbi-value-description'),
 		    strongRegex = new RegExp("^(?=.{8,})(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?=.*\\W).*$", "g"),
 		    mediumRegex = new RegExp("^(?=.{7,})(((?=.*[A-Z])(?=.*[a-z]))|((?=.*[A-Z])(?=.*[0-9]))|((?=.*[a-z])(?=.*[0-9]))).*$", "g"),
-		    enoughRegex = new RegExp("(?=.{6,}).*", "g");
+		    enoughRegex = new RegExp("(?=.{8,}).*", "g");
 
 		const pw_enabled = uci.get('rpcd', 'policy', 'enabled');
 		const pw_length = uci.get('rpcd', 'policy', 'pw_length');
@@ -40,9 +40,10 @@ return view.extend({
 		const special = uci.get('rpcd', 'policy', 'special_characters');
 
 		if (strength && value.length) {
-			if (false == enoughRegex.test(value))
+			if (false == enoughRegex.test(value)) {
 				strength.innerHTML = '%s: <span style="color:red">%s</span>'.format(_('Password strength'), _('More Characters'));
-			else if (strongRegex.test(value))
+				return false;
+			} else if (strongRegex.test(value))
 				strength.innerHTML = '%s: <span style="color:green">%s</span>'.format(_('Password strength'), _('Strong'));
 			else if (mediumRegex.test(value))
 				strength.innerHTML = '%s: <span style="color:orange">%s</span>'.format(_('Password strength'), _('Medium'));
