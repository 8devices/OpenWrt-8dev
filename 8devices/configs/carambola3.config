CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_8dev_carambola3=y
# 8devices CRA baseline common options (with LuCI)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_sudo=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SECURETTY=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGN_FIRMWARE=y
CONFIG_REQUIRE_IMAGE_SIGNATURE=y
CONFIG_JSON_CYCLONEDX_SBOM=y
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="8devices-CRA"
CONFIG_VERSION_MANUFACTURER="8devices"
CONFIG_VERSION_MANUFACTURER_URL="https://www.8devices.com"
