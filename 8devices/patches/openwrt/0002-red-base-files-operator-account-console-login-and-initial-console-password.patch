 .../base-files/files/etc/uci-defaults/51-sudoers   |  4 ++
 .../files/usr/libexec/initial-password.sh          | 58 ++++++++++++++++++++++
 package/base-files/files/usr/libexec/login.sh      |  3 +-
 7 files changed, 72 insertions(+), 1 deletion(-)

